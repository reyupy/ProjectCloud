# Copy to .env locally. Do not commit credentials or reports.
OPENSEARCH_URL=http://127.0.0.1:9200
OPENSEARCH_INDEX=flog-*
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_TIMEOUT_SECONDS=15
OPENSEARCH_PAGE_SIZE=500
OPENSEARCH_MAX_ERRORS=10000
OPENSEARCH_MAX_CHAIN_EVENTS=2000
OPENSEARCH_TIMESTAMP_FIELD=@timestamp
# Optional comma-separated date fields for records missing the primary timestamp.
# OPENSEARCH_TIMESTAMP_FALLBACK_FIELDS=timestamp,Timestamp
# Optional comma-separated additional fields by request ID namespace.
# OPENSEARCH_GLOBAL_REQUEST_ID_FIELDS=correlation.global_id
# OPENSEARCH_LOCAL_REQUEST_ID_FIELDS=correlation.local_id
# Legacy aliases: extra fields named global_request_id/global-request-id are global.
# OPENSEARCH_REQUEST_ID_FIELDS=global_request_id,request_id,context.request_id
